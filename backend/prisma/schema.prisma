generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Role {
  OWNER
  MANAGER
  CASHIER
}

enum OtpPurpose {
  REGISTER
  LOGIN
  RESET
}

enum OrderType {
  DINE_IN
  TAKE_AWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  OTHER
}

enum InventoryTxType {
  IN
  OUT
  ADJUST
  SALE
}

// ---------- Shops, users, staff ----------

model Shop {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  address   String?
  phone     String?
  email     String?
  gstNumber String?  @map("gst_number")
  logoUrl   String?  @map("logo_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users      User[]
  categories Category[]
  products   Product[]
  customers  Customer[]
  orders     Order[]
  invoices   Invoice[]
  settings   Settings?
  auditLogs  AuditLog[]

  @@map("shops")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  shopId       String    @map("shop_id") @db.Uuid
  name         String
  phone        String?   @unique
  email        String?   @unique
  passwordHash String    @map("password_hash")
  role         Role
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  shop                  Shop                   @relation(fields: [shopId], references: [id])
  staff                 Staff?
  orders                Order[]
  payments              Payment[]
  inventoryTransactions InventoryTransaction[]
  auditLogs             AuditLog[]

  @@index([shopId])
  @@map("users")
}

model Staff {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  joiningDate DateTime @default(now()) @map("joining_date") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff")
}

model OtpVerification {
  id         String     @id @default(uuid()) @db.Uuid
  identifier String
  purpose    OtpPurpose
  otpHash    String     @map("otp_hash")
  expiresAt  DateTime   @map("expires_at")
  attempts   Int        @default(0)
  verifiedAt DateTime?  @map("verified_at")
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([identifier, purpose])
  @@map("otp_verifications")
}

// ---------- Menu ----------

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  name      String
  imageUrl  String?  @map("image_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop     Shop      @relation(fields: [shopId], references: [id])
  products Product[]

  @@unique([shopId, name])
  @@map("categories")
}

model Product {
  id           String   @id @default(uuid()) @db.Uuid
  shopId       String   @map("shop_id") @db.Uuid
  categoryId   String   @map("category_id") @db.Uuid
  name         String
  sku          String
  description  String?
  imageUrl     String?  @map("image_url")
  sellingPrice Decimal  @map("selling_price") @db.Decimal(12, 2)
  costPrice    Decimal  @default(0) @map("cost_price") @db.Decimal(12, 2)
  gstPercent   Decimal  @default(5) @map("gst_percent") @db.Decimal(5, 2)
  prepTimeMin  Int?     @map("prep_time_min")
  isAvailable  Boolean  @default(true) @map("is_available")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  shop                  Shop                   @relation(fields: [shopId], references: [id])
  category              Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  inventory             Inventory?
  inventoryTransactions InventoryTransaction[]
  orderItems            OrderItem[]

  @@unique([shopId, sku])
  @@index([shopId, categoryId])
  @@index([shopId, name])
  @@map("products")
}

// ---------- Inventory ----------

model Inventory {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @unique @map("product_id") @db.Uuid
  quantity  Int      @default(0)
  minStock  Int      @default(0) @map("min_stock")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

model InventoryTransaction {
  id             String          @id @default(uuid()) @db.Uuid
  productId      String          @map("product_id") @db.Uuid
  type           InventoryTxType
  quantityChange Int             @map("quantity_change")
  reason         String?
  userId         String?         @map("user_id") @db.Uuid
  orderId        String?         @map("order_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@map("inventory_transactions")
}

// ---------- Customers and orders ----------

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  name      String
  phone     String
  email     String?
  address   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop   Shop    @relation(fields: [shopId], references: [id])
  orders Order[]

  @@unique([shopId, phone])
  @@map("customers")
}

model Order {
  id              String        @id @default(uuid()) @db.Uuid
  shopId          String        @map("shop_id") @db.Uuid
  orderNo         Int           @map("order_no")
  customerId      String?       @map("customer_id") @db.Uuid
  orderType       OrderType     @map("order_type")
  tableNo         String?       @map("table_no")
  guests          Int?
  deliveryAddress String?       @map("delivery_address")
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID) @map("payment_status")
  subtotal        Decimal       @db.Decimal(12, 2)
  discount        Decimal       @default(0) @db.Decimal(12, 2)
  tax             Decimal       @default(0) @db.Decimal(12, 2)
  deliveryCharge  Decimal       @default(0) @map("delivery_charge") @db.Decimal(12, 2)
  grandTotal      Decimal       @map("grand_total") @db.Decimal(12, 2)
  notes           String?
  createdById     String        @map("created_by_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  shop                  Shop                   @relation(fields: [shopId], references: [id])
  customer              Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy             User                   @relation(fields: [createdById], references: [id])
  items                 OrderItem[]
  payments              Payment[]
  invoice               Invoice?
  inventoryTransactions InventoryTransaction[]

  @@unique([shopId, orderNo])
  @@index([shopId, createdAt])
  @@index([shopId, status])
  @@index([customerId])
  @@map("orders")
}

// Prices are copied (snapshot) so old bills never change when the menu changes.
model OrderItem {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  nameSnapshot String   @map("name_snapshot")
  unitPrice    Decimal  @map("unit_price") @db.Decimal(12, 2)
  costPrice    Decimal  @map("cost_price") @db.Decimal(12, 2)
  gstPercent   Decimal  @map("gst_percent") @db.Decimal(5, 2)
  quantity     Int
  discount     Decimal  @default(0) @db.Decimal(12, 2)
  taxAmount    Decimal  @map("tax_amount") @db.Decimal(12, 2)
  lineTotal    Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ---------- Payments and invoices ----------

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  orderId        String        @map("order_id") @db.Uuid
  method         PaymentMethod
  amount         Decimal       @db.Decimal(12, 2)
  amountReceived Decimal?      @map("amount_received") @db.Decimal(12, 2)
  changeGiven    Decimal       @default(0) @map("change_given") @db.Decimal(12, 2)
  idempotencyKey String        @unique @map("idempotency_key")
  createdById    String        @map("created_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")

  order     Order @relation(fields: [orderId], references: [id])
  createdBy User  @relation(fields: [createdById], references: [id])

  @@index([orderId])
  @@map("payments")
}

model Invoice {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  orderId   String   @unique @map("order_id") @db.Uuid
  invoiceNo String   @map("invoice_no")
  issuedAt  DateTime @default(now()) @map("issued_at")

  shop  Shop  @relation(fields: [shopId], references: [id])
  order Order @relation(fields: [orderId], references: [id])

  @@unique([shopId, invoiceNo])
  @@map("invoices")
}

// ---------- Settings and audit ----------

model Settings {
  id                String   @id @default(uuid()) @db.Uuid
  shopId            String   @unique @map("shop_id") @db.Uuid
  invoicePrefix     String   @default("LC") @map("invoice_prefix")
  defaultGst        Decimal  @default(5) @map("default_gst") @db.Decimal(5, 2)
  defaultDiscount   Decimal  @default(0) @map("default_discount") @db.Decimal(5, 2)
  currency          String   @default("INR")
  receiptFooter     String   @default("Thank you for visiting Leo Cafe!") @map("receipt_footer")
  printerName       String?  @map("printer_name")
  showGst           Boolean  @default(true) @map("show_gst")
  showCashier       Boolean  @default(true) @map("show_cashier")
  nextOrderNumber   Int      @default(1) @map("next_order_number")
  nextInvoiceNumber Int      @default(1) @map("next_invoice_number")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String?
  entityId  String?  @map("entity_id")
  details   Json?
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  shop Shop  @relation(fields: [shopId], references: [id])
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
  @@map("audit_logs")
}
