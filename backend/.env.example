NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Phase 2: PostgreSQL connection string
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/leo_pos

# Random secrets, minimum 32 characters each
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me

# Used only by the development seed script (npm run db:seed)
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PHONE=9999999999
SEED_OWNER_PASSWORD=choose-a-strong-password

# Security (Step 14)
# Number of reverse proxies in front of the API (0 when you run it directly)
TRUST_PROXY=0
# Set to false after your cafe is registered
ALLOW_REGISTRATION=true
