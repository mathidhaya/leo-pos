# Copy this to deploy/.env (or run: bash make-env.sh your.domain.com, which fills in the secrets).
# This file never goes into git.

# The domain people type, with no https:// and no slash
SITE_ADDRESS=cafe.example.com

# Letters and numbers only (openssl rand -hex 16)
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# Long random text (openssl rand -hex 48). They must be different from each other.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Keep false once your cafe exists. The first owner is created with: docker compose exec api node dist/cli/create-owner.js
ALLOW_REGISTRATION=false

# Email for OTP codes (any SMTP service). Port 587 (STARTTLS) or 465 (TLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SMS through Twilio (India also needs DLT registration)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
